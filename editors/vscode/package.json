{
  "name": "mitti-vscode",
  "displayName": "Mitti Language Support",
  "description": "Official syntax highlighting, auto-complete and LSP integration for the Mitti programming language",
  "version": "1.0.0",
  "publisher": "mitti-lang",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/otabekoff/mitti"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "mitti",
    "python",
    "programming language",
    "lsp"
  ],
  "main": "./client.js",
  "contributes": {
    "languages": [
      {
        "id": "mitti",
        "aliases": ["Mitti", "mitti"],
        "extensions": [".mt"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "mitti",
        "scopeName": "source.mitti",
        "path": "./syntaxes/mitti.tmLanguage.json"
      }
    ]
  }
}

